# Supabase Configuration (Phase 2 Auth & Database Foundation)
# Replace these values with your actual project keys from the Supabase Dashboard.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Milestone AI Configuration (Phase 6A AI Foundation)
# The AI provider to use. Supported: 'gemini', 'openai', 'mock'
# If missing or 'mock' is selected, the application will fallback to simulated mock data.
AI_PROVIDER=mock

# Your AI provider API key. (Keep this secret and never commit to VCS).
# Leave blank to test with simulated mock responses.
AI_API_KEY=your_api_key_here

# Optional: Specific LLM model to query.
# Defaults:
# - Gemini: 'gemini-2.5-flash'
# - OpenAI: 'gpt-4o'
# AI_MODEL=gemini-2.5-flash

# Optional: Timeout in milliseconds for AI requests. Defaults to 10000 (10 seconds).
# AI_TIMEOUT_MS=10000
